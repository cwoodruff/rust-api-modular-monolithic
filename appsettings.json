{
    "ServiceName": "ModularMonolith.Api",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "RateLimiting": {
        "Policies": {
            "global:public-anon": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 },
            "catalog:api": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 },
            "orders:api": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 },
            "admin:api": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 },
            "identity:api": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 },
            "reporting:api": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 }
        }
    },
    "Caching": {
        "Enabled": true,
        "Tier": "L1",
        "Provider": "InMemory",
        "DefaultTTLSeconds": 300,
        "Modules": {
            "Catalog": { "SizeLimit": 1000 },
            "Orders": { "SizeLimit": 1000 },
            "Administration": { "SizeLimit": 500 }
        }
    },
    "Concurrency": {
        "Orders": { "QueueCapacity": 64 },
        "Reporting": { "QueueCapacity": 64, "MaxConcurrentExpensive": 4 }
    },
    "Outbox": {
        "Enabled": true,
        "PollIntervalSeconds": 1
    },
    "Reporting": {
        "Integrity": {
            "Enabled": true,
            "RunAtUtc": "02:00:00"
        }
    }
}
